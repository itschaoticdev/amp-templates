App.ExecutableLinux=/usr/bin/env
App.WorkingDir=server
App.LinuxCommandLineArgs=DOTNET_ROOT={{$FullBaseDir}}dotnet DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 {{$FullBaseDir}}server
