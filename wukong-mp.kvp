Meta.DisplayName=WukongMP (Black Myth: Wukong Multiplayer)
Meta.Description=WukongMP dedicated server by ReadyM - co-op and PvP multiplayer for Black Myth: Wukong
Meta.OS=Windows, Linux
Meta.AarchSupport=None
Meta.Arch=x86_64
Meta.Author=Breakneck Hosting
Meta.URL=https://www.ready.mp/
Meta.DisplayImageSource=steam:2358720
Meta.EndpointURIFormat=
Meta.ConfigManifest=wukong-mpconfig.json
Meta.MetaConfigManifest=wukong-mpmetaconfig.json
Meta.ConfigRoot=wukong-mp.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=On Linux the .NET 10 runtime is downloaded into the server folder, so it runs in the standard container.
Meta.ExtraSetupStepsURI=https://docs.ready.mp/wukong-mp/docs/Server/installation
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1.2
Meta.ReleaseNotes=Windows hosts need the .NET 10 runtime installed. On Linux it is downloaded into the server folder automatically.
Meta.BreakingReleaseNotes=
Meta.OriginalSource=
